{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# Re-run when the mise config changes. config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

mise="$HOME/.local/bin/mise"
if [ ! -x "$mise" ]; then
	# Plain installer on purpose: the shell variants edit rc files that chezmoi owns.
	curl -fsSL https://mise.run | sh
fi
"$mise" install
{{ end -}}
